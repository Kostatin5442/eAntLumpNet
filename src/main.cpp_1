#include <Arduino.h>
#include <Adafruit_NeoPixel.h>

// Вбудований WS2812B на ESP32-C3-MINI-1
#define LED_PIN 8
#define LED_COUNT 1  // Тільки один світлодіод

Adafruit_NeoPixel strip(LED_COUNT, LED_PIN, NEO_GRB + NEO_KHZ800);

int colorIndex = 0;

void setup() {
  Serial.begin(115200);
  delay(1500);
  
  Serial.println("=== WS2812B BLINK TEST ===");
  
  strip.begin();
  strip.setBrightness(50);  // Не надто яскраво для тесту
  strip.clear();
  strip.show();
  
  Serial.println("✅ WS2812B initialized on GPIO " + String(LED_PIN));
}

void loop() {
  // Послідовність кольорів: Червоний → Зелений → Синій → Білий → Вимкнено
  uint32_t colors[] = {
    strip.Color(255, 0, 0),    // Червоний
    strip.Color(0, 255, 0),    // Зелений
    strip.Color(0, 0, 255),    // Синій
    strip.Color(255, 255, 255),// Білий
    strip.Color(0, 0, 0)       // Вимкнено
  };
  
  const char* colorNames[] = {"🔴 Red", "🟢 Green", "🔵 Blue", "⚪ White", " OFF"};
  
  Serial.println("Color: " + String(colorNames[colorIndex]));
  
  strip.setPixelColor(0, colors[colorIndex]);
  strip.show();
  
  colorIndex = (colorIndex + 1) % 5;
  
  delay(1000);  // 1 секунда на кожен колір
}